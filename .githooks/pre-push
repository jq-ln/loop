#!/bin/sh
# Identity guard, backstop. pre-commit can be skipped with --no-verify and does
# not see commits made before the hook existed; this checks everything actually
# leaving the machine. Identity only — see .githooks/pre-commit.

set -e

ALLOWED='77815101+jq-ln@users.noreply.github.com'
ZERO='0000000000000000000000000000000000000000'
status=0

while read -r _local_ref local_oid _remote_ref remote_oid; do
    [ "$local_oid" = "$ZERO" ] && continue
    if [ "$remote_oid" = "$ZERO" ]; then
        range=$(git rev-list "$local_oid" --not --remotes)
    else
        range=$(git rev-list "$remote_oid..$local_oid")
    fi
    for sha in $range; do
        bad=$(git show -s --format='%ae%n%ce' "$sha" | grep -v "^${ALLOWED}$" || true)
        if [ -n "$bad" ]; then
            printf '  Blocked: %s carries %s\n' "$(git show -s --format='%h %s' "$sha")" "$(printf '%s' "$bad" | tr '\n' ' ')"
            status=1
        fi
    done
done

if [ "$status" -ne 0 ]; then
    printf '\n  Expected %s on every author and committer line.\n' "$ALLOWED"
    printf '  These commits cannot be edited after publication, only excised.\n\n'
fi

exit $status
