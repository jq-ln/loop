{
  "permissions": {
    "deny": [
      "Bash(git merge:*)",
      "Bash(git pull:*)",
      "Bash(just land:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/deny-merge.py\""
          }
        ]
      }
    ]
  }
}
